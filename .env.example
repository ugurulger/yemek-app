EXPO_PUBLIC_ANTHROPIC_API_KEY=
EXPO_PUBLIC_GOOGLE_API_KEY=
# claude | gemini — vision sağlayıcı A/B testi (envanter çıkarımı), bkz. services/vision/
EXPO_PUBLIC_VISION_PROVIDER=gemini
# true | false (varsayılan) — DENEYSEL: Gemini'ye kareler yerine ham videoyu
# native gönder, bkz. services/vision/gemini-provider.ts ve SKILL.md
EXPO_PUBLIC_GEMINI_NATIVE_VIDEO=false
# live | mock — mağaza fiyat sağlayıcıları (AH/Jumbo), bkz. services/stores/
# Tanımsızsa: web'de mock (CORS), native'de live.
EXPO_PUBLIC_STORE_PROVIDER=
# ah | jumbo | both — SADECE mock modda mağaza çökmesi simülasyonu (test)
EXPO_PUBLIC_STORE_MOCK_FAIL=

# --- RAG (BLOK A, bkz. README-rag.md) ---
# true | false (varsayılan) — tarif üretimini Supabase generate-recipe edge
# function'ına yönlendirir; kapalıyken mevcut iki aşamalı Claude akışı çalışır.
EXPO_PUBLIC_USE_RAG=false
# Supabase proje URL'i + anon key (SADECE bunlar client'a girer; Anthropic/
# Google anahtarları edge function secrets'ında yaşar).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- App Store bağlantıları (Ayarlar ekranı, bkz. lib/appLinks.ts) ---
# Boşsa placeholder (example.com) kullanılır — GÖNDERİM ÖNCESİ gerçek URL şart.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_SUPPORT_URL=

# --- Analitik (PostHog EU) + crash raporlama (Sentry) — bkz. tracking/README.md ---
# PostHog EU Cloud proje API anahtarı (https://eu.posthog.com — GDPR: EU host zorunlu)
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Sentry EU bölgesi DSN'i (org açarken EU data residency seç)
EXPO_PUBLIC_SENTRY_DSN=
# "true" → dev build'de de event gönder (normalde dev'de kapalı)
EXPO_PUBLIC_ANALYTICS_DEBUG=
